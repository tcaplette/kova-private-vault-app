<?xml version="1.0" encoding="utf-8"?>
<!--
  Deny-all. Nothing leaves the device via cloud backup or device-to-device
  transfer. Paired with android:allowBackup="false" so the behaviour holds
  across API levels rather than depending on one mechanism.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
